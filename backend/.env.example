PORT=5000
NODE_ENV=production
MONGO_URI=your_mongodb_atlas_connection_string

JWT_SECRET=your_strong_jwt_access_secret_32chars_min
JWT_REFRESH_SECRET=your_strong_jwt_refresh_secret_32chars_min

# Cloudinary Config
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Razorpay Payment Config
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Gmail SMTP Config (Nodemailer)
# Step 1: Enable 2-Step Verification on your Google Account
# Step 2: Go to https://myaccount.google.com/apppasswords
# Step 3: Generate a 16-character App Password for "Mail > Other"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_FROM=Your Business Name <your_gmail_address@gmail.com>
